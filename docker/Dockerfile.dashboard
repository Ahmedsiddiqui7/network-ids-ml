# Cycle 5 -- packages the Next.js dashboard. data/replay_flows.json is real
# repo content (checked in, not gitignored), so it's copied in normally --
# unlike artifacts/, nothing needs to be mounted at runtime here.
FROM node:20-slim

WORKDIR /app

COPY src/dashboard/package.json src/dashboard/package-lock.json ./
RUN npm ci

COPY src/dashboard/ .
RUN npm run build

EXPOSE 3000

# Explicit -H 0.0.0.0: `next start`'s default bind host isn't reliable
# enough to trust silently inside a container -- must not bind to
# 127.0.0.1, or the port mapping to the host is unreachable.
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
